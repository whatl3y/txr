    if (!filePathToSend)
        return clientObj.reject(`Make sure you pass an absolute filepath (-f or --file) to send a file.\n`);
    if (!userToSend)
        return clientObj.reject(`Make sure you pass a user (-u or --username) to send a file to.\n`);
